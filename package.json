{
  "name": "@ivmartel/dwv-react",
  "version": "0.11.0-beta.0",
  "description": "Medical viewer using DWV (DICOM Web Viewer) and React.",
  "author": "ivmartel",
  "license": "GPL-3.0",
  "keywords": [
    "dicom",
    "medical",
    "imaging",
    "viewer",
    "dwv",
    "react",
    "mui"
  ],
  "homepage": "https://github.com/ivmartel/dwv-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivmartel/dwv-react.git"
  },
  "bugs": {
    "url": "https://github.com/ivmartel/dwv-react/issues"
  },
  "type": "module",
  "module": "./dist/dwv-react-lib/index.js",
  "exports": {
    ".": "./dist/dwv-react-lib/index.js",
    "./style.css": "./dist/dwv-react-lib/style.css",
    "./vite-plugin": "./plugins/dwvWorkers.js"
  },
  "files": [
    "dist/dwv-react-lib/**",
    "plugins/dwvWorkers.js"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dwv": "0.37.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@napi-rs/canvas": "^1.0.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-trunk": "vite build --mode development --base /dwv-react/demo/trunk",
    "build-stable": "vite build --mode production --base /dwv-react/demo/stable",
    "build-lib": "vite build --config vite.lib.config.js",
    "prepack": "yarn build-lib",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "test-ci": "vitest run --coverage"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "packageManager": "yarn@4.18.0"
}
